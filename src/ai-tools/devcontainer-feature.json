{
  "id": "ai-tools",
  "version": "1.2.0",
  "name": "AI CLI tools",
  "description": "Installs Claude Code, OpenAI Codex, and Happy globally. Mounts persistent config volumes for each tool and bind-mounts the shared agents/skills directory from the host. Persists ~/.claude.json (onboarding state, project trust, MCP config) by symlinking into the .claude volume.",
  "mounts": [
    { "source": "atlas-claude-config", "target": "/home/node/.claude", "type": "volume" },
    { "source": "atlas-codex-config", "target": "/home/node/.codex", "type": "volume" },
    { "source": "atlas-happy-config", "target": "/home/node/.happy", "type": "volume" },
    { "source": "/mnt/user/files/3 - Resources/AI/agents", "target": "/home/node/agents", "type": "bind" },
    { "source": "/mnt/user/files/3 - Resources/AI/agents/skills", "target": "/home/node/.claude/skills", "type": "bind" },
    { "source": "/mnt/user/files/3 - Resources/AI/agents/skills", "target": "/home/node/.codex/skills", "type": "bind" }
  ],
  "entrypoint": "/usr/local/share/ai-tools/entrypoint.sh"
}
